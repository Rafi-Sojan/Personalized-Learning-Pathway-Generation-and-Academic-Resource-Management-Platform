FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app
WORKDIR /app
COPY backend/requirements.txt ./requirements.txt
COPY backend/requirements-ocr.txt ./requirements-ocr.txt
RUN apt-get update \
    && apt-get install --no-install-recommends -y tesseract-ocr \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir -r requirements.txt -r requirements-ocr.txt
COPY backend/app ./app
COPY backend/migrations ./migrations
COPY ml ./ml
COPY scripts ./scripts
RUN useradd --create-home --uid 10001 appuser && mkdir -p /app/storage/uploads /app/storage/processed && chown -R appuser:appuser /app
USER appuser
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
